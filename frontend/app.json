{
  "expo": {
    "name": "HerdCare",
    "slug": "herdcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "herdcare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.herdcare.app"
    },
    "android": {
      "package": "com.herdcare.app",
      "adaptiveIcon": {
        "backgroundColor": "#2C7A3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
          ]
        }
      ],
      "./plugins/withFullscreenSplash",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B7440",
          "image": "./assets/splash-blank.png",
          "imageWidth": 200,
          "ios": {
            "backgroundColor": "#2B7440",
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6820787e-534e-492b-a221-c0fb4568c3c1"
      }
    },
    "owner": "mogul1",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/6820787e-534e-492b-a221-c0fb4568c3c1",
      "checkAutomatically": "ON_LOAD"
    }
  }
}
