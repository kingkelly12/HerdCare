    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.6",
    "expo-font": "^57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-notifications": "^57.0.17",
    "expo-print": "^57.0.1",
    "expo-router": "~57.0.20",
    "expo-sharing": "^57.0.18",
    "expo-splash-screen": "^57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "^57.0.21",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "^57.0.11",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools",
    "license": "esbuild tools/issue-license.ts --bundle --platform=node --format=esm --external:tweetnacl --outfile=node_modules/.cache/herdcare-license.mjs --log-level=warning && node node_modules/.cache/herdcare-license.mjs",
    "license:test": "esbuild tools/license.test.ts --bundle --platform=node --format=esm --external:tweetnacl --outfile=node_modules/.cache/herdcare-license-test.mjs --log-level=warning && node node_modules/.cache/herdcare-license-test.mjs"
  },
  "private": true
}
