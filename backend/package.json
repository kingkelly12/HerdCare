{
  "name": "herdcare-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Licence and subscription service for HerdCare, on Cloudflare Workers and D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply herdcare --local",
    "db:remote": "wrangler d1 migrations apply herdcare --remote",
    "db:console": "wrangler d1 execute herdcare --remote --command",
    "test": "esbuild test/license.test.ts --bundle --platform=node --format=esm --external:tweetnacl --outfile=node_modules/.cache/herdcare-backend-test.mjs --log-level=warning && node node_modules/.cache/herdcare-backend-test.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.86.0",
    "esbuild": "^0.25.12",
    "tweetnacl": "^1.0.3"
  }
}
