# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files
#
# `.env*.local` alone did NOT cover a plain `.env`, which is the file people actually create.
# These patterns have no leading slash, so they apply in every directory: frontend/.env and
# backend/.env are both caught here. `.env.example` stays tracked on purpose, so the *names* of
# the variables can be shared without their values.
#
# Nothing secret belongs in frontend/ at all. Anything reachable from the app's bundle ships
# inside the APK and can be read straight out of it — a Cloudflare API token lives as a Worker
# secret (`wrangler secret put`), never in a file the app can see.
.env
.env.*
!.env.example
*.env

# Cloudflare
# `.dev.vars` holds real local secrets. `.dev.vars.example` holds only the variable *names* and
# must stay tracked, so the negation below has to come after the wildcard that would catch it.
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/

# typescript
*.tsbuildinfo

# generated native folders
ios/
android/

# local sqlite db files (device-only, never checked in)
*.db
*.db-journal

# backend
backend/dist/
